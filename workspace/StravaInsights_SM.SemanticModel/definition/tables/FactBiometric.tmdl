table FactBiometric
	lineageTag: 69e9c645-55b7-4a07-938a-bdd01c789698
	sourceLineageTag: [dbo].[FactBiometric]

	/// Device VO2max when available, otherwise the best estimate (running VDOT or cycling ACSM) in the selected period. Prefer the sport-specific measures.
	measure VO2max = COALESCE(CALCULATE(MAX(FactBiometric[value]), FactBiometric[metric_code] = "vo2max_ml_kg_min", FactBiometric[is_estimate] = FALSE()), CALCULATE(MAX(FactBiometric[value]), FactBiometric[metric_code] = "vo2max_ml_kg_min"))
		formatString: 0.0
		displayFolder: Biometrics
		lineageTag: 1f184c85-94b2-4854-aaa7-9f1bb22331fd

	/// Cycling VO2max estimate (ACSM: 10.8 x best 5-min power / body weight + 7), best in the selected period. Needs body weight.
	measure 'VO2max Cycling' = CALCULATE(MAX(FactBiometric[value]), FactBiometric[metric_code] = "vo2max_ml_kg_min", FactBiometric[method] = "estimated_cycling_5min_power_acsm")
		formatString: 0.0
		displayFolder: Biometrics
		lineageTag: 6f6edc99-7f1c-4c3a-9b06-b98655c68feb

	/// Running VO2max estimate (Jack Daniels VDOT from best-effort pace, 1.5 km - marathon), best in the selected period.
	measure 'VO2max Running' = CALCULATE(MAX(FactBiometric[value]), FactBiometric[metric_code] = "vo2max_ml_kg_min", FactBiometric[method] = "estimated_running_vdot")
		formatString: 0.0
		displayFolder: Biometrics
		lineageTag: d3ec5d80-e37d-4823-b13e-4ee24abeebc8

	measure 'VO2max Source' =
			IF(CALCULATE(MAX(FactBiometric[value]), FactBiometric[metric_code] = "vo2max_ml_kg_min", FactBiometric[is_estimate] = FALSE()) > 0, "Measured by device",
			    IF(ISBLANK([VO2max Running]) && ISBLANK([VO2max Cycling]), "No estimate in this period", "Estimated per sport"))
		displayFolder: Biometrics
		lineageTag: c06562e8-6d0b-42cd-bedb-bef7c57860e3

	/// Latest known body weight up to the end of the selected period.
	measure 'Body Weight kg' =
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			RETURN
			    IF(MIN(DimDate[Date]) > TODAY(), BLANK(),
			    CALCULATE(
			        LASTNONBLANKVALUE(DimDate[Date], AVERAGE(FactBiometric[value])),
			        FactBiometric[metric_code] = "body_weight_kg",
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] <= _end
			    ))
		formatString: 0.0
		displayFolder: Biometrics
		lineageTag: a1a9118b-944c-4af8-842b-7025f8ca2677

	/// FTP for the selected period: 95% of the best 20-min power in the period, else the profile FTP.
	measure 'FTP Latest W' = COALESCE([FTP Estimate W], [FTP Any Source W])
		formatString: 0
		displayFolder: Biometrics
		lineageTag: 4b1f3a06-7707-4277-8d6c-cca9cdeba51c

	measure 'FTP Any Source W' =
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			RETURN
			    IF(MIN(DimDate[Date]) > TODAY(), BLANK(),
			    CALCULATE(
			        LASTNONBLANKVALUE(DimDate[Date], MAX(FactBiometric[value])),
			        FactBiometric[metric_code] = "ftp_watts",
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] <= _end
			    ))
		formatString: 0
		displayFolder: Biometrics
		lineageTag: 00e05a1f-74bf-429e-9b37-3ac8f26124c0

	measure 'W per kg' = DIVIDE([FTP Latest W], [Body Weight kg])
		formatString: 0.00
		displayFolder: Biometrics
		lineageTag: b4f8dfa0-a8e7-4603-b0a6-c6e516cd655c

	measure 'Max HR Latest' =
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			RETURN
			    IF(MIN(DimDate[Date]) > TODAY(), BLANK(),
			    CALCULATE(
			        LASTNONBLANKVALUE(DimDate[Date], MAX(FactBiometric[value])),
			        FactBiometric[metric_code] = "max_heart_rate_bpm",
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] <= _end
			    ))
		formatString: 0
		displayFolder: Biometrics
		lineageTag: cf81e424-62c7-4a4c-a9e8-dab7ae9f66d8

	measure 'Resting HR' = CALCULATE(AVERAGE(FactBiometric[value]), FactBiometric[metric_code] = "resting_heart_rate_bpm")
		formatString: 0
		displayFolder: Biometrics
		lineageTag: 7f9ed84f-7b3a-455d-b65b-7d325e74b1a6

	measure 'HRV ms' = CALCULATE(AVERAGE(FactBiometric[value]), FactBiometric[metric_code] = "hrv_rmssd_ms")
		formatString: 0
		displayFolder: Biometrics
		lineageTag: 2236ff8d-b0ad-41cc-bdcf-8a2d87561099

