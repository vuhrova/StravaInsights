	measure 'Data Checks' = COUNTROWS(DataQualityCheck)
		formatString: 0
		displayFolder: Data health
		lineageTag: a1e9072e-28d3-421a-9925-bdb26146b7f3

	/// Font color for a data check result (fail / warn / pass).
	measure 'Result Color' =
			SWITCH(SELECTEDVALUE(DataQualityCheck[status]),
			    "fail", "#DC2626", "warn", "#B45309", "pass", "#15803D", "#64748B")
		displayFolder: Data health
		lineageTag: 37a76c5e-605d-4de3-8ee5-ee976f4ee0fe

