table DataStatus
	lineageTag: 974a58c8-a558-4bd4-b99a-dcc0c220a381
	sourceLineageTag: [dbo].[DataStatus]

	/// One-line data status shown at the bottom of every page.
	measure 'Data Status Line' =
			VAR _latest = MAX(DataStatus[latest_workout_date])
			VAR _sync = MAX(DataStatus[last_sync_utc])
			VAR _passed = MAX(DataStatus[checks_passed])
			VAR _evaluated = MAX(DataStatus[checks_evaluated])
			RETURN
			    IF(ISBLANK(_sync), "Waiting for the first data load",
			        "Data as of " & FORMAT(_latest, "d MMM yyyy")
			        & "  ·  Synced " & FORMAT(_sync, "d MMM HH:mm") & " UTC"
			        & "  ·  " & FORMAT(_passed, "0") & "/" & FORMAT(_evaluated, "0") & " data checks passed"
			        & IF(MAX(DataStatus[checks_failed]) > 0, "  ·  " & MAX(DataStatus[status_text]), ""))
		displayFolder: Data health
		lineageTag: b3feef2d-600d-4f6d-8d1c-15f927f301ed

	measure 'Data Health' = SELECTEDVALUE(DataStatus[overall_status], "Not checked")
		displayFolder: Data health
		lineageTag: e09188be-3694-467a-824f-2416f2c491ba

	/// Finish time of the last successful Strava sync (UTC).
	measure 'Last Sync' = VAR _s = MAX(DataStatus[last_sync_utc]) RETURN IF(ISBLANK(_s), "Never", FORMAT(_s, "d MMM HH:mm") & " UTC")
		displayFolder: Data health
		lineageTag: b5d73126-61d9-4a02-903f-1fa64efde236

	measure 'Latest Workout' = FORMAT(MAX(DataStatus[latest_workout_date]), "d MMM yyyy")
		displayFolder: Data health
		lineageTag: 1570c01f-6aab-4f03-bbf4-c12e76e8d9aa

	measure 'Checks Passed' = MAX(DataStatus[checks_passed])
		formatString: 0
		displayFolder: Data health
		lineageTag: 2d59263f-41f9-4a75-afd8-c4e0090e5f39

	measure 'Checks Warning' = MAX(DataStatus[checks_warning])
		formatString: 0
		displayFolder: Data health
		lineageTag: f61d431a-4ebc-4b16-a4a5-3ea5b155a9c2

	measure 'Checks Failed' = MAX(DataStatus[checks_failed])
		formatString: 0
		displayFolder: Data health
		lineageTag: 9cc48fd4-d9de-403b-be8b-9eb56c5da741

	/// Detailed activity data still to download; Strava's API limits spread a long history over several daily runs.
	measure 'History Backfill' =
			VAR _d = MAX(DataStatus[details_to_backfill])
			VAR _s = MAX(DataStatus[streams_to_backfill])
			RETURN IF(ISBLANK(_d), "-", IF(_d + _s = 0, "Complete", FORMAT(_d + _s, "#,0") & " to go"))
		displayFolder: Data health
		lineageTag: 229e3e3a-5591-4c3b-a77f-63f5c7852635

