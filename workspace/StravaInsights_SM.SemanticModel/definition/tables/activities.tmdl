table activities
	lineageTag: 143d95c6-7f4f-4909-aa91-733a49ff157e
	sourceLineageTag: [dbo].[FactWorkout]

	measure 'Total Workouts' = COUNTROWS(activities)
		formatString: 0
		lineageTag: af52bc2e-8e46-44fa-86ff-4dc82d7f9355

		changedProperty = Name

	/// Total distance / total moving time.
	measure 'Avg Speed kmh' = DIVIDE([Total Distance km], [Total Hours])
		displayFolder: Activities
		formatString: 0.0
		lineageTag: c7b657c9-4e38-4e6d-ac94-434589bd22ac

	/// Average power of rides with power, weighted by moving time.
	measure 'Avg Watts' =
			VAR _rows = FILTER(activities, NOT ISBLANK(activities[average_watts]) && activities[average_watts] > 0)
			RETURN DIVIDE(SUMX(_rows, activities[average_watts] * activities[duration_minutes]), SUMX(_rows, activities[duration_minutes]))
		displayFolder: Activities
		formatString: 0
		lineageTag: 276bf0ba-13de-45c1-aad1-c1f333b95526

	/// Average heart rate, weighted by moving time.
	measure 'Avg Heart Rate' =
			VAR _rows = FILTER(activities, NOT ISBLANK(activities[average_heartrate]) && activities[average_heartrate] > 0)
			RETURN DIVIDE(SUMX(_rows, activities[average_heartrate] * activities[duration_minutes]), SUMX(_rows, activities[duration_minutes]))
		displayFolder: Activities
		formatString: 0
		lineageTag: 29804abf-d7c2-4058-a990-e8f8cf825b44

	measure 'Avg Temperature' = AVERAGE(activities[average_temp])
		formatString: 0.0
		lineageTag: 0a419878-71f6-49fc-b671-5e6b940d1f00

		changedProperty = Name

	measure 'Total Distance km' = SUM(activities[distance_km])
		formatString: #,0
		lineageTag: 6463c0f0-055b-47f3-a53c-ff47bc5e94a5

		changedProperty = Name

	measure 'Total Hours' = SUM(activities[duration_minutes]) / 60
		formatString: #,0.0
		lineageTag: 52b674af-fd5d-4370-9595-4936e4eb9c91

		changedProperty = Name

	measure 'Day of Week' = FORMAT(activities[start_date_local], "ddd")
		lineageTag: a40bc1f4-82be-4148-b8cd-1795f57cfe7f

		changedProperty = Name

	measure 'Pace per km' =
			VAR fam = SELECTEDVALUE(activities[activity_family_name])
			VAR s = IF(fam IN {"Running", "Walking"}, ROUND(DIVIDE(SUM(activities[duration_minutes]), SUM(activities[distance_km])) * 60, 0))
			RETURN IF(ISBLANK(s) || s = 0, BLANK(), FORMAT(INT(s / 60), "0") & ":" & FORMAT(MOD(s, 60), "00") & " /km")
		lineageTag: 49a46fd6-4926-4959-b1f9-b32a7bd2009f

	measure 'Moving Time' =
			VAR m = ROUND(SUM(activities[duration_minutes]), 0)
			RETURN IF(ISBLANK(m), BLANK(), FORMAT(INT(m / 60), "0") & "h " & FORMAT(MOD(m, 60), "00") & "m")
		lineageTag: ed14a157-9a7f-4b38-8d26-9379ebe98f66

	measure 'Max Speed kmh' = MAX(activities[max_speed]) * 3.6
		formatString: 0.0
		lineageTag: 8bd60822-98fc-466e-877b-8af01811d715

	/// Average normalized power, weighted by moving time.
	measure 'Avg Normalized Power' =
			VAR _rows = FILTER(activities, NOT ISBLANK(activities[weighted_average_watts]) && activities[weighted_average_watts] > 0)
			RETURN DIVIDE(SUMX(_rows, activities[weighted_average_watts] * activities[duration_minutes]), SUMX(_rows, activities[duration_minutes]))
		formatString: 0
		displayFolder: Activities
		lineageTag: a2051a7c-6a6f-4974-a68e-8e098f0b2b87

	measure 'Total Training Load' = SUM(activities[training_load_score])
		formatString: #,0
		lineageTag: b433ba30-288c-4562-be03-fec5e96ff187

	measure 'Total Calories kcal' = SUM(activities[calories_kcal])
		formatString: #,0
		lineageTag: f3c2b1fa-8700-4275-a802-cae3f130cfe0

	measure 'Activity Type' = SELECTEDVALUE(activities[activity_type_name], "Multiple")
		lineageTag: 34c8bd7e-f012-400e-8e9c-77314cf9e8dd

	measure 'Total Duration Minutes' = SUM(activities[duration_minutes])
		formatString: #,0
		displayFolder: Activities
		lineageTag: 753c915c-a4ea-4b98-b01c-54969d170b6f

	measure 'Total Elevation Gain m' = SUM(activities[total_elevation_gain])
		formatString: #,0
		displayFolder: Activities
		lineageTag: 023dcd8d-0ece-48f1-9d7d-49008f5a7991

	measure 'Max Power' = MAX(activities[max_watts])
		formatString: 0
		displayFolder: Activities
		lineageTag: 27bcfcfc-35df-49b4-9505-cd8012fa4e0c

	measure 'Max Heart Rate' = MAX(activities[max_heartrate])
		formatString: 0
		displayFolder: Activities
		lineageTag: 766e2c17-fffe-4028-9a94-3048e756c8fb

	measure 'Avg Cadence' =
			VAR _rows = FILTER(activities, NOT ISBLANK(activities[average_cadence]) && activities[average_cadence] > 0)
			RETURN DIVIDE(SUMX(_rows, activities[average_cadence] * activities[duration_minutes]), SUMX(_rows, activities[duration_minutes]))
		formatString: 0
		displayFolder: Activities
		lineageTag: 0a7430ec-6bb6-4f7a-a76f-6d2f0180ff4f

	/// Steps per minute (Strava reports running cadence per leg), weighted by moving time.
	measure 'Avg Running Cadence spm' =
			VAR _rows = FILTER(activities, NOT ISBLANK(activities[average_cadence]) && activities[average_cadence] > 0)
			RETURN DIVIDE(SUMX(_rows, activities[average_cadence] * activities[duration_minutes]), SUMX(_rows, activities[duration_minutes])) * 2
		formatString: 0
		displayFolder: Activities
		lineageTag: 88fa520b-c6e2-489a-b61b-befb948cac8d

	measure 'Avg Pace min per km' = DIVIDE(SUM(activities[duration_minutes]), SUM(activities[distance_km]))
		formatString: 0.00
		displayFolder: Activities
		lineageTag: 31d93d78-2704-493a-b612-5030f72e6ed1

	measure 'Longest Distance km' = MAX(activities[distance_km])
		formatString: 0.0
		displayFolder: Activities
		lineageTag: 09e5a456-64d9-47cc-88fd-df185c9ea2ff

	measure 'Workouts per Week' =
			VAR _days = DATEDIFF(MIN(DimDate[Date]), MIN(MAX(DimDate[Date]), TODAY()), DAY) + 1
			RETURN DIVIDE([Total Workouts], _days / 7)
		formatString: 0.0
		displayFolder: Activities
		lineageTag: be7846c8-c22a-4897-8f06-dff0d5122aac

	measure 'Distance per Week km' =
			VAR _days = DATEDIFF(MIN(DimDate[Date]), MIN(MAX(DimDate[Date]), TODAY()), DAY) + 1
			RETURN DIVIDE([Total Distance km], _days / 7)
		displayFolder: Activities
		formatString: #,0.0
		lineageTag: 8c3eb599-e115-41ee-a012-cbe56edab488

	measure 'Hours per Week' =
			VAR _days = DATEDIFF(MIN(DimDate[Date]), MIN(MAX(DimDate[Date]), TODAY()), DAY) + 1
			RETURN DIVIDE([Total Hours], _days / 7)
		formatString: 0.0
		displayFolder: Activities
		lineageTag: 4d610dfb-2077-49ee-8f6a-eae921313ac7

	measure 'Best Effort Time' =
			VAR s = MIN(activity_best_efforts[duration_s])
			RETURN IF(ISBLANK(s), BLANK(),
			    IF(s >= 3600, FORMAT(INT(s / 3600), "0") & ":" & FORMAT(INT(MOD(s, 3600) / 60), "00") & ":" & FORMAT(MOD(s, 60), "00"),
			        FORMAT(INT(s / 60), "0") & ":" & FORMAT(MOD(s, 60), "00")))
		displayFolder: Activities
		lineageTag: 3755d95a-8608-42f0-8bb3-eeabfc6dfd64

	measure 'Best 5K' = CALCULATE([Best Effort Time], activity_best_efforts[effort_type] = "Distance", activity_best_efforts[effort_name] IN {"5k", "5K"})
		displayFolder: Activities
		lineageTag: ba0cfb5d-d849-4ded-abd7-4f070dc7e06d

	measure 'Best 10K' = CALCULATE([Best Effort Time], activity_best_efforts[effort_type] = "Distance", activity_best_efforts[effort_name] IN {"10k", "10K"})
		displayFolder: Activities
		lineageTag: 0dbbac0c-110c-49c3-a5f8-67904a9e2a80

	measure 'Best 20 min Power W' = CALCULATE(MAX(activity_best_efforts[avg_power_w]), activity_best_efforts[effort_type] = "Power", activity_best_efforts[effort_name] = "20 min", KEEPFILTERS(activities[activity_family_name] = "Cycling"))
		formatString: 0
		displayFolder: Activities
		lineageTag: 1868a95c-b297-4d21-830c-3532026e03b7

	measure 'Best 5 min Power W' = CALCULATE(MAX(activity_best_efforts[avg_power_w]), activity_best_efforts[effort_type] = "Power", activity_best_efforts[effort_name] = "5 min", KEEPFILTERS(activities[activity_family_name] = "Cycling"))
		formatString: 0
		displayFolder: Activities
		lineageTag: 4116bb6d-25b3-425b-a867-dbef93881c80

	/// 95% of the best 20-minute power in the current filter context (e.g. per month).
	measure 'FTP Estimate W' = ROUND(0.95 * [Best 20 min Power W], 0)
		formatString: 0
		displayFolder: Activities
		lineageTag: 62d7fbe7-a92d-4dc2-a55a-8267e5f6c9f0

	/// Best average cycling power in the current context (use with activity_best_efforts[effort_name] for a power curve).
	measure 'Best Power in Period W' = CALCULATE(MAX(activity_best_efforts[avg_power_w]), activity_best_efforts[effort_type] = "Power", KEEPFILTERS(activities[activity_family_name] = "Cycling"))
		formatString: 0
		displayFolder: Activities
		lineageTag: aff1c6c9-e163-45aa-897b-fa32c867fd00

	/// Best Power in Period W in the period just before the selected one (same number of days).
	measure 'Best Power Prev Period W' =
			VAR _start = MIN(DimDate[Date])
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			VAR _days = INT(_end - _start) + 1
			RETURN
			    IF(_start > TODAY(), BLANK(),
			    CALCULATE(
			        [Best Power in Period W],
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] >= _start - _days, DimDate[Date] < _start
			    ))
		formatString: 0
		displayFolder: Activities
		lineageTag: bb479007-e23b-4d11-9fd0-479a3e16ae24

	measure 'FTP Prev Period W' =
			VAR _start = MIN(DimDate[Date])
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			VAR _days = INT(_end - _start) + 1
			RETURN
			    IF(_start > TODAY(), BLANK(),
			    CALCULATE(
			        [FTP Estimate W],
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] >= _start - _days, DimDate[Date] < _start
			    ))
		formatString: 0
		displayFolder: Activities
		lineageTag: 6cff7e98-880a-4850-9acf-736debd1c8f5

	/// Change of the FTP estimate against the period just before the selected one.
	measure 'FTP Change vs Prev Period' = DIVIDE([FTP Estimate W] - [FTP Prev Period W], [FTP Prev Period W])
		formatString: +0%;-0%;0%
		displayFolder: Activities
		lineageTag: a59a1333-f780-4f6a-9890-10952331f09a

	measure 'Best Effort Time Prev Period' =
			VAR _start = MIN(DimDate[Date])
			VAR _end = MIN(MAX(DimDate[Date]), TODAY())
			VAR _days = INT(_end - _start) + 1
			RETURN
			    IF(_start > TODAY(), BLANK(),
			    CALCULATE(
			        [Best Effort Time],
			        REMOVEFILTERS(DimPeriod), REMOVEFILTERS(DimDate),
			        DimDate[Date] >= _start - _days, DimDate[Date] < _start
			    ))
		displayFolder: Activities
		lineageTag: 3396ebbd-4255-4c4e-b9fc-ea17b958d482

